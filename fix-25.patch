@@ -74,6 +74,12 @@ static void lcd_fill(uint32_t x, uint32_t y, uint32_t w, uint32_t h, uint16_t c)
         w = 240u - x;
     if (y + h > 240u)
         h = 240u - y;
+    /* Stretch virtual rows 0..239 onto the 320 physical display rows. */
+    {
+        uint32_t end = y + h;
