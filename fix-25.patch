@@ -88,10 +94,22 @@ static void lcd_fill(uint32_t x, uint32_t y, uint32_t w, uint32_t h, uint16_t c)
 
 static void lcd_blit(uint32_t x, uint32_t y, uint32_t w, uint32_t h, const uint16_t *px)
 {
+    uint32_t r = 0u, group = 3u - (y % 3u), end;
     if (!w || !h)
         return;
-    lcd_window(x, y, x + w - 1u, y + h - 1u);
-    lcd_data(px, w * h * 2u);
+    end = y + h;
+    lcd_window(x, y + y / 3u, x + w - 1u, end + end / 3u - 1u);
+    /* Every third source row is sent twice: 240 virtual -> 320 physical.
+     * Send up to three contiguous rows per DMA, keeping the original strip
+     * buffer and the same draw coordinates for the entire Kitten UI. */
+    while (r < h) {
+        uint32_t n = h - r < group ? h - r : group;
+        lcd_data(px + r * w, n * w * 2u);
+        r += n;
+        if (n == group)
+            lcd_data(px + (r - 1u) * w, w * 2u);
+        group = 3u;
+    }
 }
 
